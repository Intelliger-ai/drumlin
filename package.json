{
  "name": "drumlin-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workspace root. The published package is assembled into packages/drumlin by `pnpm build`.",
  "license": "Apache-2.0",
  "author": "Intelliger AI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Intelliger-ai/drumlin.git"
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "drumlin": "tsx apps/cli/src/main.ts",
    "drumlind": "tsx apps/daemon/src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "boundaries": "node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "node scripts/smoke-pack.mjs",
    "bench:warm": "node scripts/bench-warm.mjs",
    "probe:mcp": "node scripts/probe-mcp.mjs",
    "probe:hooks": "node scripts/probe-hooks.mjs",
    "probe:loop": "node scripts/probe-loop.mjs",
    "check": "pnpm boundaries && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@drumlin/indexer": "workspace:*",
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
